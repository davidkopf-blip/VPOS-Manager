<Window
    x:Class="DumpLoader_2._0.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Settings">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{StaticResource WindowBackground}" RowDefinitions="Auto,*" RequestedTheme="Dark">

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32" Background="{StaticResource WindowBackground}">
            <TextBlock Text="Settings" Foreground="{StaticResource SecondaryText}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>

        <Grid Grid.Row="1" Padding="24">
            <Border Background="{StaticResource CardBackground}" CornerRadius="12" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Settings" Foreground="{StaticResource PrimaryText}" FontSize="18" FontWeight="SemiBold" />

                    <StackPanel Spacing="8">
                        <TextBlock Text="DumpEditor.exe Path" Foreground="{StaticResource SecondaryText}" FontSize="13" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="DumpEditorPathTextBox" Width="400" IsReadOnly="True" PlaceholderText="Not set" />
                            <Button x:Name="BrowseButton" Content="Browse..." Click="BrowseButton_Click" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                            <Grid Width="13" Height="13" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusHaloEllipse" Width="13" Height="13" />
                                <Ellipse x:Name="StatusDotEllipse" Width="7" Height="7" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="StatusText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="CloseButton" Content="Close" Click="CloseButton_Click" HorizontalAlignment="Right" Style="{StaticResource PrimaryButtonStyle}" Margin="0,10,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

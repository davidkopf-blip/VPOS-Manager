<Window
    x:Class="DumpLoader_2._0.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Settings">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="24" Background="{StaticResource WindowBackground}" RequestedTheme="Dark">
        <Border Background="{StaticResource CardBackground}" CornerRadius="12" Padding="16">
            <StackPanel Spacing="12">
                <TextBlock Text="Settings" Foreground="{StaticResource PrimaryText}" FontSize="18" FontWeight="SemiBold" />

                <TextBlock Text="DumpEditor.exe Path" Foreground="{StaticResource PrimaryText}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="DumpEditorPathTextBox" Width="360" IsReadOnly="True" PlaceholderText="Not set" />
                    <Button x:Name="BrowseButton" Content="Browse..." Click="BrowseButton_Click" />
                </StackPanel>

                <Button x:Name="CloseButton" Content="Close" Click="CloseButton_Click" HorizontalAlignment="Right" Style="{StaticResource PrimaryButtonStyle}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

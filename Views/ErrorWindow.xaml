<Window
    x:Class="DumpLoader_2._0.Views.ErrorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Error">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Background="{StaticResource WindowBackground}" RowDefinitions="Auto,*" RequestedTheme="Dark">

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="32" Background="{StaticResource WindowBackground}">
            <TextBlock Text="Error" Foreground="{StaticResource SecondaryText}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" />
        </Grid>

        <Grid Grid.Row="1" Padding="24">
            <Border Background="{StaticResource CardBackground}" CornerRadius="12" Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Top">
                        <TextBlock Text="⚠" Foreground="{StaticResource DangerText}" FontSize="28" VerticalAlignment="Top" />
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock x:Name="ErrorTitleText" Foreground="{StaticResource PrimaryText}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="ErrorMessageText" Foreground="{StaticResource SecondaryText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>

                    <Button x:Name="DetailsToggleButton" Content="Show details" Click="DetailsToggleButton_Click"
                            Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" />

                    <Border x:Name="DetailsBorder" Background="{StaticResource TerminalBackground}" CornerRadius="8" Padding="12" Visibility="Collapsed">
                        <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <TextBlock x:Name="DetailsTextBlock" Foreground="{StaticResource SecondaryText}"
                                       FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"
                                       TextWrapping="NoWrap" IsTextSelectionEnabled="True" />
                        </ScrollViewer>
                    </Border>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button x:Name="CopyDetailsButton" Content="Copy details" Click="CopyDetailsButton_Click" Style="{StaticResource SecondaryButtonStyle}" />
                        <Button x:Name="CloseButton" Content="Close" Click="CloseButton_Click" Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

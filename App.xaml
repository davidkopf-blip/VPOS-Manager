<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DumpLoader_2._0.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DumpLoader_2._0">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Theme colors -->
            <SolidColorBrush x:Key="WindowBackground" Color="#FF1E1E1E" />
            <SolidColorBrush x:Key="CardBackground" Color="#FF252526" />
            <SolidColorBrush x:Key="PrimaryAccent" Color="#FF00C853" />
            <SolidColorBrush x:Key="PrimaryText" Color="White" />
            <SolidColorBrush x:Key="SecondaryText" Color="#FFC8C8C8" />

            <!--
              Override the system accent color (normally the OS purple) so built-in control
              chrome that derives from it - text selection highlight, focus rings, checked
              CheckBox/ToggleSwitch fills, ComboBox selection, etc. - matches PrimaryAccent
              instead of the Windows-wide accent color.
            -->
            <Color x:Key="SystemAccentColor">#FF00C853</Color>
            <Color x:Key="SystemAccentColorLight1">#FF40D67E</Color>
            <Color x:Key="SystemAccentColorLight2">#FF80E4A9</Color>
            <Color x:Key="SystemAccentColorLight3">#FFBFF1D4</Color>
            <Color x:Key="SystemAccentColorDark1">#FF00963E</Color>
            <Color x:Key="SystemAccentColorDark2">#FF006429</Color>
            <Color x:Key="SystemAccentColorDark3">#FF003214</Color>

            <!-- Button style -->
            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource PrimaryAccent}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <!-- Secondary and Danger button styles -->
            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#FF3A3A3A" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="DangerButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#FFD32F2F" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <!-- Converters placeholder: added in code -->
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" xmlns:converters="using:DumpLoader_2._0.Converters" />
            <converters:CountToCollapsedConverter x:Key="CountToCollapsedConverter" xmlns:converters="using:DumpLoader_2._0.Converters" />
        </ResourceDictionary>
    </Application.Resources>
</Application>

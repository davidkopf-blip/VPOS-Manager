<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="DumpLoader_2._0.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DumpLoader_2._0">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Theme colors -->
            <SolidColorBrush x:Key="WindowBackground" Color="#FF17181A" />
            <SolidColorBrush x:Key="CardBackground" Color="#FF252526" />
            <SolidColorBrush x:Key="FieldBackground" Color="#FF1B1B1C" />
            <SolidColorBrush x:Key="PrimaryAccent" Color="#FF00C853" />
            <SolidColorBrush x:Key="AccentInk" Color="#FF0C1F13" />
            <SolidColorBrush x:Key="PrimaryText" Color="White" />
            <SolidColorBrush x:Key="SecondaryText" Color="#FFC8C8C8" />
            <SolidColorBrush x:Key="MutedText" Color="#FF9A9A9A" />
            <SolidColorBrush x:Key="HairlineBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="FieldBorderBrush" Color="#1FFFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="DangerBackground" Color="#29D32F2F" />
            <SolidColorBrush x:Key="DangerBorderBrush" Color="#80D32F2F" />
            <SolidColorBrush x:Key="DangerText" Color="#FFFF8A80" />

            <!--
              Override the system accent color (normally the OS purple) so built-in control
              chrome that derives from it - text selection highlight, focus rings, checked
              CheckBox/ToggleSwitch fills, ComboBox selection, etc. - matches PrimaryAccent
              instead of the Windows-wide accent color.
            -->
            <Color x:Key="SystemAccentColor">#FF00C853</Color>
            <Color x:Key="SystemAccentColorLight1">#FF40D67E</Color>
            <Color x:Key="SystemAccentColorLight2">#FF80E4A9</Color>
            <Color x:Key="SystemAccentColorLight3">#FFBFF1D4</Color>
            <Color x:Key="SystemAccentColorDark1">#FF00963E</Color>
            <Color x:Key="SystemAccentColorDark2">#FF006429</Color>
            <Color x:Key="SystemAccentColorDark3">#FF003214</Color>

            <!--
              ToggleSwitch reads these specific theme resource keys for its track/knob fills
              rather than a plain Background property - overriding them here recolors every
              ToggleSwitch in the app to the green/gray pill look without a full ControlTemplate.
            -->
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#FF00C853" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#FF1FD466" />
            <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#FF00A344" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#FF00C853" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOnPointerOver" Color="#FF1FD466" />
            <SolidColorBrush x:Key="ToggleSwitchFillOff" Color="#FF4A4A4A" />
            <SolidColorBrush x:Key="ToggleSwitchFillOffPointerOver" Color="#FF565656" />
            <SolidColorBrush x:Key="ToggleSwitchStrokeOff" Color="#FF6E6E6E" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="White" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOff" Color="White" />

            <!-- Default (unstyled) Button look - matches the mockup's neutral ".btn" style;
                 PrimaryButtonStyle/DangerButtonStyle opt in to something different on top. -->
            <Style TargetType="Button">
                <Setter Property="Background" Value="#FF3A3A3A" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="Height" Value="34" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{StaticResource ButtonBorderBrush}" />
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource PrimaryAccent}" />
                <Setter Property="Foreground" Value="{StaticResource AccentInk}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="Height" Value="34" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#FF3A3A3A" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Height" Value="30" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{StaticResource ButtonBorderBrush}" />
            </Style>
            <Style x:Key="DangerButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource DangerBackground}" />
                <Setter Property="Foreground" Value="{StaticResource DangerText}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Height" Value="30" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{StaticResource DangerBorderBrush}" />
            </Style>

            <!-- Large CTA variant (the two "start" buttons) -->
            <Style x:Key="LargeButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#FF3A3A3A" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="Height" Value="48" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{StaticResource ButtonBorderBrush}" />
            </Style>
            <Style x:Key="LargePrimaryButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource PrimaryAccent}" />
                <Setter Property="Foreground" Value="{StaticResource AccentInk}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="Height" Value="48" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!-- Section eyebrow label (e.g. "GENERAL SETTINGS") -->
            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource MutedText}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="40" />
            </Style>

            <!-- Field styling (applies to every TextBox/PasswordBox/ComboBox in the app) -->
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource FieldBackground}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="12,0" />
            </Style>
            <Style TargetType="PasswordBox">
                <Setter Property="Background" Value="{StaticResource FieldBackground}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="12,0" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="{StaticResource FieldBackground}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource FieldBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="12,0" />
            </Style>

            <!-- Converters placeholder: added in code -->
            <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" xmlns:converters="using:DumpLoader_2._0.Converters" />
            <converters:CountToCollapsedConverter x:Key="CountToCollapsedConverter" xmlns:converters="using:DumpLoader_2._0.Converters" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
